# Build artifacts
.gradle/
build/
*.class

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store

# Sensitive / local-only (do NOT track)
CLAUDE.md
CLAUDE.local.md
.claude/

# Target-derived output — may contain secrets or client data
output/
collected-js/
*-report.json
*-report.html

# Local screenshots / scratch images (not part of the extension)
*.png
*.jpg
*.jpeg
*.gif

# Local raw payload/wordlist scratch files used as a source to mine when expanding
# patterns/*.json — the curated result goes in the tracked JSON, the raw corpus doesn't
# (may carry third-party domains from a public fuzzing list; not part of the extension).
src/main/resources/patterns/*.txt
