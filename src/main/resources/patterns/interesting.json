{
  "comment": "Signatures for interesting/verbose responses (errors, stack traces, debug, listings). Scanned against response bodies. Same shape as secrets.json.",
  "patterns": [
    { "name": "Java Stack Trace", "severity": "MEDIUM", "regex": "(?<![\\w.$])[\\w.$]{1,100}?(?:Exception|Error)(?::[^\\n]{0,300})?\\n(?:\\s{0,20}at\\s{1,20}[\\w.$]{1,160}\\([^)\\n]{0,200}\\)\\n){2,}" },
    { "name": "Java Exception", "severity": "LOW", "regex": "\\b(?:java|javax|org\\.springframework|jakarta)\\.[\\w.$]*(?:Exception|Error)\\b" },
    { "name": "Python Traceback", "severity": "MEDIUM", "regex": "Traceback \\(most recent call last\\):" },
    { "name": ".NET Stack Trace", "severity": "MEDIUM", "regex": "System\\.[\\w.]+Exception[\\s\\S]{0,80}?\\bat\\s+[\\w.<>]+\\(" },
    { "name": "ASP.NET Error Page", "severity": "MEDIUM", "regex": "(?i)Server Error in '/' Application|<b>\\s*Description:\\s*</b>\\s*An unhandled exception" },
    { "name": "PHP Error", "severity": "MEDIUM", "regex": "(?i)\\b(?:Fatal error|Parse error|Warning|Notice)\\s{0,8}:\\s.{1,500}? in\\s{1,8}(?:/|[A-Za-z]:\\\\).{1,500}? on line \\d+" },
    { "name": "PHP var_dump", "severity": "LOW", "regex": "\\barray\\(\\d+\\)\\s*\\{|\\bobject\\([\\w\\\\]+\\)#\\d+" },
    { "name": "Ruby/Rails Error", "severity": "MEDIUM", "regex": "(?i)(?:ActionController|ActiveRecord|NoMethodError|RuntimeError)[^\\n]{0,120}\\n\\s+(?:app|lib|config)/" },
    { "name": "Node.js Stack Trace", "severity": "MEDIUM", "regex": "\\n\\s+at\\s+[\\w.$<> \\[\\]]+\\((?:/|[A-Za-z]:\\\\)[^)]*:\\d+:\\d+\\)" },
    { "name": "SQL Error", "severity": "HIGH", "regex": "(?i)(?:SQL syntax.{0,200}MySQL|Warning.{0,200}mysqli?_|valid MySQL result|PostgreSQL.{0,200}ERROR|ORA-\\d{5}|Microsoft OLE DB Provider for SQL Server|Unclosed quotation mark after the character string|SQLSTATE\\[)" },
    { "name": "Directory Listing", "severity": "MEDIUM", "regex": "(?i)<title>\\s*(?:Index of /|Directory listing for)|<h1>\\s*Index of /" },
    { "name": "Debug Mode Enabled", "severity": "MEDIUM", "regex": "(?i)(?:Werkzeug Debugger|Whoops!|DEBUG\\s*=\\s*True|<title>[^<]*Debug[^<]*</title>|X-Debug-Token)" },
    { "name": "Internal Path Disclosure", "severity": "LOW", "regex": "(?:/var/www/|/home/[\\w.-]+/|/usr/local/|C:\\\\inetpub\\\\|C:\\\\xampp\\\\|/app/|/srv/www/)[\\w./\\\\-]+" },
    { "name": "Stack trace (JSON)", "severity": "LOW", "regex": "\"stack(?:Trace|_trace)\"\\s*:\\s*\"" }
  ]
}
