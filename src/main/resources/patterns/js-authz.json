{
  "comment": "Client-side authorization / permission logic locators (0.47.0). Scanned against JS bodies only. Passive: flags where the UI makes access decisions in the browser (classic client-side-only authz) for manual review. Bounded spans (ReDoS). Reported non-sensitive.",
  "patterns": [
    { "name": "Client-side admin/role check", "severity": "MEDIUM", "regex": "(?i)(?:is_?admin|is_?superuser|is_?staff|is_?owner|has_?role|has_?permission|has_?authority|can_?access|can_?edit|is_?authorized|checkPermission|checkRole|userHasRole)\\s{0,5}\\(" },
    { "name": "Role equality comparison", "severity": "MEDIUM", "regex": "(?i)(?:\\.role|\\brole|userRole|user_?type|account_?type|\\.scope)\\s{0,5}[=!]==?\\s{0,5}[\"'](?:admin|administrator|superuser|super_?admin|root|owner|manager|moderator|staff|operator|sysadmin)[\"']" },
    { "name": "Route/auth guard", "severity": "LOW", "regex": "(?i)(?:requireAuth|requiresAuth|authGuard|roleGuard|canActivate|beforeEnter|requireRole|requireLogin|PrivateRoute|ProtectedRoute|RequireAuth|withAuth|ensureAuthenticated)\\b" },
    { "name": "Client-side permission list", "severity": "LOW", "regex": "(?i)[\"']?(?:permissions|roles|scopes|authorities|grants|privileges|capabilities|acl)[\"']?\\s{0,5}[:=]\\s{0,5}[\\[{]" },
    { "name": "Admin UI gating flag", "severity": "LOW", "regex": "(?i)(?:showAdmin|isAdminView|adminOnly|admin_?only|enableAdmin|admin_?enabled|canSeeAdmin|displayAdmin)\\s{0,8}[:=]" }
  ]
}
