    { "kind": "library", "label": "Angular $1", "banner": "@license Angular v(\\d{1,2}\\.\\d{1,2}\\.\\d{1,2})" },
    { "kind": "library", "label": "Lodash", "banner": "@license Lodash\\b|Lodash <https://lodash\\.com/>" },
    { "kind": "library", "label": "Bootstrap $1", "banner": "Bootstrap v(\\d{1,2}\\.\\d{1,2}\\.\\d{1,2})" },
    { "kind": "library", "label": "Moment", "banner": "//! moment\\.js" },
    { "kind": "library", "label": "core-js polyfill", "banner": "core-js \\d{1,2}\\.\\d{1,2}|\\(c\\) 20\\d\\d-20\\d\\d Denis Pushkarev" },
    { "kind": "library", "label": "Swiper $1", "banner": "Swiper (\\d{1,2}\\.\\d{1,2}\\.\\d{1,2})" }
  ]
