{
  "comment": "Dangerous JS execution / DOM-XSS sink & source locators (0.47.0). Scanned against JS bodies only. Passive: points at code worth manual review (a sink isn't a vuln unless it meets attacker-controlled input). Bounded spans (ReDoS). Reported non-sensitive.",
  "patterns": [
    { "name": "eval() call", "severity": "MEDIUM", "regex": "\\beval\\s{0,5}\\(" },
    { "name": "Function constructor", "severity": "MEDIUM", "regex": "\\bnew\\s{1,5}Function\\s{0,5}\\(" },
    { "name": "innerHTML/outerHTML write", "severity": "LOW", "regex": "\\.(?:inner|outer)HTML\\s{0,5}=[^=]" },
    { "name": "document.write() call", "severity": "LOW", "regex": "\\bdocument\\.(?:write|writeln)\\s{0,5}\\(" },
    { "name": "insertAdjacentHTML sink", "severity": "LOW", "regex": "\\.insertAdjacentHTML\\s{0,5}\\(" },
    { "name": "setTimeout/setInterval string arg", "severity": "LOW", "regex": "\\b(?:setTimeout|setInterval)\\s{0,5}\\(\\s{0,5}[\"']" },
    { "name": "postMessage send", "severity": "LOW", "regex": "\\.postMessage\\s{0,5}\\(" },
    { "name": "message event listener", "severity": "LOW", "regex": "addEventListener\\s{0,5}\\(\\s{0,5}[\"']message[\"']" },
    { "name": "DOM XSS source", "severity": "LOW", "regex": "\\b(?:location\\.(?:hash|search|href|pathname)|document\\.(?:URL|documentURI|referrer|baseURI)|window\\.name)\\b" },
    { "name": "document.cookie access", "severity": "INFO", "regex": "\\bdocument\\.cookie\\b" },
    { "name": "jQuery .html() sink", "severity": "LOW", "regex": "\\.html\\s{0,5}\\(\\s{0,5}[^)\\s]" },
    { "name": "React dangerouslySetInnerHTML", "severity": "LOW", "regex": "dangerouslySetInnerHTML\\b" }
  ]
}
